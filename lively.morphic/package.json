        ]
      },
      "text/position.js": {
        "environments": [
          "client",
          "server"
        ]
      },
      "text/range.js": {
        "environments": [
          "client",
          "server"
        ]
      },
      "text/anchors.js": {
        "environments": [
          "client",
          "server"
        ]
      },
      "text/attributes.js": {
        "environments": [
          "client",
          "server"
        ]
      },
      "events/Keys.js": {
        "environments": [
          "client",
