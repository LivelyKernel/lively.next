{
  "name": "lively.app",
  "version": "0.1.0",
  "description": "lively.next as a standalone NW.js desktop application",
  "type": "module",
  "main": "desktop/boot.html",
  "systemjs": {
    "main": "index.js"
  },
  "bg-script": "desktop/background-menu.js",
  "node-main": "--experimental-import-meta-resolve",
  "inject_js_start": "desktop/inject-start.js",
  "inject_js_end": "desktop/inject.js",
  "single-instance": true,
  "window": {
    "title": "lively.next",
    "width": 1440,
    "height": 900,
    "min_width": 800,
    "min_height": 600,
    "position": "center",
    "show": true,
    "frame": true,
    "resizable": true
  },
  "chromium-args": "--enable-features=NWESM --enable-node-worker --disable-raf-throttling --remote-debugging-port=9222",
  "exports": {
    ".": "./index.js",
    "./resources.js": "./resources.js"
  },
  "dependencies": {
    "lively.server": "workspace:*",
    "lively.installer": "workspace:*",
    "nw": "0.111.1-sdk",
    "velopack": "0.0.1444-gc245055",
    "lively.resources": "workspace:*",
    "lively.storage": "workspace:*"
  },
  "scripts": {
    "start": "bash start.sh",
    "setup": "bash setup.sh"
  },
  "node-remote": [
    "file:///*/lively.freezer/landing-page/index.html",
    "file:///*/lively.freezer/loading-screen/index.html"
  ]
}
