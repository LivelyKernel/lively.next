{
  "name": "lively.ast",
  "version": "0.11.3",
  "description": "Parsing JS code into ASTs and tools to query and transform these trees.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "mocha-es6 tests/*-test.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LivelyKernel/lively.ast.git"
  },
  "keywords": [
    "LivelyWeb",
    "parser",
    "parsing",
    "estree",
    "ast",
    "lively"
  ],
  "author": "Robert Krahn",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/LivelyKernel/lively.ast/issues"
  },
  "homepage": "https://github.com/LivelyKernel/lively.ast",
  "dependencies": {
    "lively.lang": "workspace:*",
    "esutils": "2.0.3",
    "@javascript-obfuscator/estraverse": "5.4.0",
    "astq": "2.7.5",
    "escodegen": "2.0.0",
    "acorn-class-fields": "1.0.0",
    "acorn-loose": "8.0.2",
    "acorn-private-methods": "1.0.0",
    "acorn-static-class-features": "1.0.0",
    "acorn-walk": "8.2.0",
    "acorn": "8.0.4"
  },
  "devDependencies": {
    "acorn": "8.0.4",
    "estree-to-js": "^0.4.0",
    "mocha-es6": "workspace:*"
  },
  "systemjs": {
    "main": "index.js",
    "map": {
      "astq": {
        "node": "@empty"
      },
      "util": {
        "node": "@node/util",
        "~node": "@empty"
      },
      "child_process": {
        "node": "@node/child_process",
        "~node": "@empty"
      }
    }
  }
}
